# ═══════════════════════════════════════════════════════════════
# THIS FILE = THE GENUINELY-FREE STACK (no credit card, anywhere)
# ═══════════════════════════════════════════════════════════════

# ── Script generation (LLM) ──────────────────────────────────────
# Groq: genuinely free, no card. console.groq.com/keys — 30 sec signup.
# 30 req/min, 14,400 req/day — far more than one person needs.
GROQ_API_KEY=

# ── Trend research (optional) ────────────────────────────────────
# Tavily: genuinely free, recurring — 1,000 credits every month, no card.
# tavily.com. Skips cleanly if left blank; scripting still works.
# (Note: Serper is NOT used by default here — its free tier is a
# one-time 2,500-query trial, not a monthly reset, so it runs out.)
TAVILY_API_KEY=

# ── Voiceover (text-to-speech) ───────────────────────────────────
# ElevenLabs: genuinely free, no card — ~10 min of audio/month.
# elevenlabs.io — sign up, grab a key, pick a voice ID from your library.
# IMPORTANT: the free tier is NON-COMMERCIAL only. Fine for testing
# and personal use; if you ever plan to monetize, you'll need a paid
# plan (from $5/mo) at that point -- not before.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Visuals ───────────────────────────────────────────────────────
# "static-doodle" is the default and costs $0 -- no signup, no key needed.
# It renders simple placeholder frames so the whole pipeline runs
# end-to-end for free. Swap to a paid provider later once you're ready
# to spend on real AI-generated visuals (see lib/providers/visuals.ts).
VISUAL_PROVIDER=static-doodle

# ── Storage ───────────────────────────────────────────────────────
# Local disk is fine for testing on this free stack.
STORAGE_MODE=local
